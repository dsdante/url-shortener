# ===========================================================================
# HTTP: ACME challenges + redirect to HTTPS, for both hostnames.
# ===========================================================================
server {
    listen 8080;
    listen [::]:8080;
    server_name ${DOMAIN} ${UI_DOMAIN};

    location ^~ /.well-known/acme-challenge/ {
        root /var/www/certbot;
        default_type "text/plain";
        try_files $uri =404;
    }

    # Plain-HTTP health probe. Kept here so container healthchecks and
    # uptime monitors do not have to follow a redirect.
    location = /health {
        access_log off;
        proxy_pass http://app:8000/health;
        include /etc/nginx/snippets/proxy.conf;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

# ===========================================================================
# HTTPS on the UI hostname: static SPA + same-origin API.
# ===========================================================================
server {
    listen 8443 ssl;
    listen [::]:8443 ssl;
    http2 on;
    server_name ${UI_DOMAIN};

    ssl_certificate         /etc/letsencrypt/live/${DOMAIN}/fullchain.pem;
    ssl_certificate_key     /etc/letsencrypt/live/${DOMAIN}/privkey.pem;
    ssl_trusted_certificate /etc/letsencrypt/live/${DOMAIN}/chain.pem;
    ssl_stapling on;
    ssl_stapling_verify on;

    include /etc/nginx/snippets/security-headers-ui.conf;
    limit_conn addr 20;

    root /usr/share/nginx/html;
    index index.html;

    location = /health {
        access_log off;
        proxy_pass http://app:8000/health;
        include /etc/nginx/snippets/proxy.conf;
    }

    location = /links {
        limit_req zone=create burst=3 nodelay;
        limit_req_status 429;
        client_max_body_size 16k;
        proxy_pass http://app:8000/links;
        include /etc/nginx/snippets/proxy.conf;
    }

    location ~ ^/links/[A-Za-z0-9]+/stats$ {
        limit_req zone=general burst=20 nodelay;
        limit_req_status 429;
        proxy_pass http://app:8000;
        include /etc/nginx/snippets/proxy.conf;
    }

    # Short-code redirect. The regex is quoted — `{1,16}` would otherwise
    # be parsed as a block delimiter and break startup with
    # "unknown directive …".
    location ~ "^/[A-Za-z0-9]{1,16}$" {
        limit_req zone=general burst=40 nodelay;
        limit_req_status 429;
        proxy_pass http://app:8000;
        include /etc/nginx/snippets/proxy.conf;
    }

    # SPA fallback: everything else serves index.html.
    location / {
        try_files $uri $uri/ /index.html;
    }
}

# ===========================================================================
# HTTPS on the API hostname: API only, no SPA.
# ===========================================================================
server {
    listen 8443 ssl;
    listen [::]:8443 ssl;
    http2 on;
    server_name ${DOMAIN};

    ssl_certificate         /etc/letsencrypt/live/${DOMAIN}/fullchain.pem;
    ssl_certificate_key     /etc/letsencrypt/live/${DOMAIN}/privkey.pem;
    ssl_trusted_certificate /etc/letsencrypt/live/${DOMAIN}/chain.pem;
    ssl_stapling on;
    ssl_stapling_verify on;

    include /etc/nginx/snippets/security-headers.conf;
    limit_conn addr 20;

    # ---------------------------------------------------------------------
    # Documentation routes.
    #
    # Must be *exact-match* (`location = …`), not regex. The short-code
    # regex below matches `/docs` (4 alphanumeric chars), and Nginx uses
    # the FIRST matching regex in file order — so `location ~ ^/(docs|…)$`
    # placed after it would be shadowed, the request would hit the
    # short-code block, inherit the strict CSP, and the browser would
    # refuse to load Swagger's CDN assets (blank page).
    #
    # Exact matches always beat regex, regardless of order.
    #
    # They include security-headers-docs.conf because *any* `add_header`
    # in a location disables inheritance of the server-level
    # `add_header` set — including HSTS. Repeating the full set here is
    # what keeps HSTS on these routes.
    # ---------------------------------------------------------------------
    location = /docs {
        include /etc/nginx/snippets/security-headers-docs.conf;
        proxy_pass http://app:8000;
        include /etc/nginx/snippets/proxy.conf;
    }

    location = /redoc {
        include /etc/nginx/snippets/security-headers-docs.conf;
        proxy_pass http://app:8000;
        include /etc/nginx/snippets/proxy.conf;
    }

    location = /openapi.json {
        include /etc/nginx/snippets/security-headers-docs.conf;
        proxy_pass http://app:8000;
        include /etc/nginx/snippets/proxy.conf;
    }

    location = /health {
        access_log off;
        proxy_pass http://app:8000/health;
        include /etc/nginx/snippets/proxy.conf;
    }

    location = /links {
        limit_req zone=create burst=3 nodelay;
        limit_req_status 429;
        client_max_body_size 16k;
        proxy_pass http://app:8000/links;
        include /etc/nginx/snippets/proxy.conf;
    }

    location ~ ^/links/[A-Za-z0-9]+/stats$ {
        limit_req zone=general burst=20 nodelay;
        limit_req_status 429;
        proxy_pass http://app:8000;
        include /etc/nginx/snippets/proxy.conf;
    }

    location ~ "^/[A-Za-z0-9]{1,16}$" {
        limit_req zone=general burst=40 nodelay;
        limit_req_status 429;
        proxy_pass http://app:8000;
        include /etc/nginx/snippets/proxy.conf;
    }

    location / {
        limit_req zone=general burst=40 nodelay;
        limit_req_status 429;
        proxy_pass http://app:8000;
        include /etc/nginx/snippets/proxy.conf;
    }
}
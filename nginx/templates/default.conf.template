# --- HTTP: ACME challenge + redirect to HTTPS ------------------------------
server {
    listen 8080;
    listen [::]:8080;
    server_name ${DOMAIN};

    location ^~ /.well-known/acme-challenge/ {
        root /var/www/certbot;
        default_type "text/plain";
        try_files $uri =404;
    }

    # NEW: health probe for the Docker healthcheck — never redirects.
    location = /health {
        access_log off;
        proxy_pass http://app:8000/health;
        include /etc/nginx/snippets/proxy.conf;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

# --- HTTPS -----------------------------------------------------------------
server {
    listen 8443 ssl;
    listen [::]:8443 ssl;
    http2 on;
    server_name ${DOMAIN};

    ssl_certificate         /etc/letsencrypt/live/${DOMAIN}/fullchain.pem;
    ssl_certificate_key     /etc/letsencrypt/live/${DOMAIN}/privkey.pem;

    include /etc/nginx/snippets/security-headers.conf;

    limit_conn addr 20;

    # Never serve dotfiles, source maps, or script extensions.
    location ~ /\. { deny all; return 404; }
    location ~* \.(php|asp|aspx|jsp|cgi|map)$ { deny all; return 404; }

    location = /health {
        access_log off;
        proxy_pass http://app:8000/health;
        include /etc/nginx/snippets/proxy.conf;
    }

    # Link creation: 5 requests/minute per IP, 16 KiB body cap.
    location = /links {
        limit_req zone=create burst=3 nodelay;
        limit_req_status 429;
        client_max_body_size 16k;
        proxy_pass http://app:8000/links;
        include /etc/nginx/snippets/proxy.conf;
    }

    location ~ ^/links/[A-Za-z0-9]+/stats$ {
        limit_req zone=general burst=20 nodelay;
        limit_req_status 429;
        proxy_pass http://app:8000;
        include /etc/nginx/snippets/proxy.conf;
    }

    location / {
        limit_req zone=general burst=40 nodelay;
        limit_req_status 429;
        proxy_pass http://app:8000;
        include /etc/nginx/snippets/proxy.conf;
    }
}
# .env.example — copy to `.env` (git-ignored) and edit as needed.

# Host port the API is published on.
APP_PORT=8000

# --- application settings -------------------------------------------------
# SQLAlchemy DSN. Leave unset to keep the default SQLite file inside the
# `url-shortener-data` volume. For Postgres, uncomment the second line
# (requires `--profile postgres` and psycopg2-binary in requirements.txt).
#DATABASE_URL=sqlite:////app/data/links.db
#DATABASE_URL=postgresql+psycopg2://urls:urls@db:5432/urls

# Set to "false" to skip the single outbound HEAD check on POST /links.
# Recommended for offline / air-gapped networks.
CHECK_URL_AVAILABILITY=true

# Timeout (seconds) and max attempts for that availability check.
HTTP_TIMEOUT=5.0
HTTP_RETRIES=2

# --- Postgres credentials (only used with --profile postgres) -------------
#POSTGRES_USER=urls
#POSTGRES_PASSWORD=urls
#POSTGRES_DB=urls

# Expose /docs, /redoc and /openapi.json. Set to "false" in production.
ENABLE_DOCS=true
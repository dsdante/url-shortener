# --- public hostname and TLS ---
DOMAIN=short.example.com
LETSENCRYPT_EMAIL=admin@example.com

# 1 = use Let's Encrypt staging (untrusted cert) for testing the script.
CERTBOT_STAGING=0

# --- application ---
APP_PORT=8000
CHECK_URL_AVAILABILITY=false
HTTP_TIMEOUT=5.0
HTTP_RETRIES=2
ENABLE_DOCS=false

# --- Postgres (only with --profile postgres) ---
#POSTGRES_USER=urls
#POSTGRES_PASSWORD=change-me
#POSTGRES_DB=urls
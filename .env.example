# --- hostnames ------------------------------------------------------------
# Primary cert lineage and API hostname.
DOMAIN=api.short.example.com
# UI hostname — must have an A record pointing at the same host.
# Added to the SAME certificate via `deploy/expand-cert.sh` below.
UI_DOMAIN=short.example.com
LETSENCRYPT_EMAIL=admin@example.com

# 1 = use Let's Encrypt staging (untrusted cert) for testing the script.
CERTBOT_STAGING=0

# --- application ---
APP_PORT=8000
CHECK_URL_AVAILABILITY=false
HTTP_TIMEOUT=5.0
HTTP_RETRIES=2
ENABLE_DOCS=false

# --- Postgres (only with --profile postgres) ---
#POSTGRES_USER=urls
#POSTGRES_PASSWORD=change-me
#POSTGRES_DB=urls